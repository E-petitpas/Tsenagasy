generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// *
///  * ========================
///  * UTILISATEUR DE BASE
///  * ========================
model Utilisateur {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supabaseId       String          @unique @db.Uuid // Lien avec Supabase Auth
  email            String          @unique
  adresse          String
  nom              String
  tel              String          @db.VarChar(15)
  createdAt        DateTime        @default(now())          // ← date de création
  lastLogin        DateTime?
  acheteur         Acheteur?
  commercant       Commercant?
  livraisonsRecues Livraison[]     @relation("LivraisonDestinataire")
  paniers          Panier[]
  relationClient   RelationClient?
  superAdmin       SuperAdmin?

  @@map("users")
}

/// *
///  * ========================
///  * ROLES
///  * ========================
model SuperAdmin {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  utilisateurId String      @unique @db.Uuid
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@map("superAdmin")
}

model RelationClient {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  utilisateurId String      @unique @db.Uuid
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@map("relationClient")
}

model Acheteur {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  utilisateurId String      @unique @db.Uuid
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  paniers       Panier[]

  @@map("acheteurs")
}

model Commercant {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  utilisateurId String      @unique @db.Uuid
  type          String
  nomEntreprise String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  produits      Produit[]

  @@map("commercants")
}

/// *
///  * ========================
///  * CATALOGUE
///  * ========================
model Categorie {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom      String
  produits Produit[]

  @@map("categories")
}

model Produit {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom          String
  prix         Decimal    @db.Decimal(12, 2)
  stock        Int        @default(0)
  images       String[]   @db.Text // <- tableau d’URLs vers les images
  tags         String[]   @db.Text
  categorieId  String     @db.Uuid
  commercantId String     @db.Uuid
  paniers      Panier[]   @relation("PanierProduit")
  description  String
  poids        Int
  dimensions   String
  materiaux    String
  statut       String
  createdAt    DateTime @default(now())
  categorie    Categorie  @relation(fields: [categorieId], references: [id])
  commercant   Commercant @relation(fields: [commercantId], references: [id])

  @@index([categorieId])
  @@index([commercantId])
  @@map("produits")
}

/// *
///  * ========================
///  * PANIER
///  * ========================
model Panier {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  utilisateurId String      @db.Uuid
  produitId     String      @db.Uuid
  quantite      Int
  acheteurId    String      @db.Uuid
  livraison     Livraison?
  paiement      Paiement?
  Acheteur      Acheteur    @relation(fields: [acheteurId], references: [id])
  produit       Produit     @relation("PanierProduit", fields: [produitId], references: [id])
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@index([utilisateurId])
  @@index([produitId])
  @@map("panier")
}

/// *
///  * ========================
///  * PAIEMENT
///  * ========================
model Paiement {
  id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  panierId String          @unique @db.Uuid
  methode  MethodePaiement
  statut   StatutPaiement
  montant  Decimal         @db.Decimal(12, 2)
  panier   Panier          @relation(fields: [panierId], references: [id])

  @@map("paiement")
}

/// *
///  * ========================
///  * LIVRAISON
///  * ========================
model Livraison {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  montant        Decimal     @db.Decimal(12, 2)
  destinataireId String      @db.Uuid
  panierId       String      @unique @db.Uuid
  destinataire   Utilisateur @relation("LivraisonDestinataire", fields: [destinataireId], references: [id])
  panier         Panier      @relation(fields: [panierId], references: [id])

  @@index([destinataireId])
  @@map("livraison")
}

/// *
///  * ========================
///  * ENUMS
///  * ========================
enum MethodePaiement {
  mobile_money
  carte
  espece_livraison
  portefeuille
}

enum StatutPaiement {
  en_attente
  reussi
  echoue
  rembourse
  annule
}
